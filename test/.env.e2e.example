# ===========================================
# E2E TEST ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env.test for local E2E testing

# ===========================================
# SUPABASE TEST INSTANCE
# ===========================================
# Use a dedicated test Supabase project or test schema
# RECOMMENDED: Create a separate Supabase project for testing
SUPABASE_URL=your_test_supabase_url
SUPABASE_ANON_KEY=your_test_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_test_supabase_service_role_key

# ===========================================
# JWT CONFIGURATION (Test Secrets)
# ===========================================
# Use different secrets from production
JWT_SECRET=test_jwt_secret_min_32_chars_for_e2e_testing_only
JWT_REFRESH_SECRET=test_jwt_refresh_secret_min_32_chars_for_e2e_testing
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
NONCE_EXPIRATION=300

# ===========================================
# STELLAR / SOROBAN (Testnet)
# ===========================================
# Always use testnet for E2E tests
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ===========================================
# CONTRACT ADDRESSES (Test Contracts)
# ===========================================
# Deploy test contracts on Stellar testnet for E2E testing
# These contracts should be separate from dev/prod contracts
REPUTATION_CONTRACT_ID=your_test_reputation_contract_id
CREDIT_LINE_CONTRACT_ID=your_test_credit_line_contract_id
LIQUIDITY_CONTRACT_ID=your_test_liquidity_contract_id
MERCHANT_REGISTRY_CONTRACT_ID=your_test_merchant_registry_contract_id

# ===========================================
# REDIS (Test Instance)
# ===========================================
# Use a separate Redis database for tests (e.g., db=1)
# This ensures test data doesn't interfere with dev
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=
REDIS_DB=1
REPUTATION_CACHE_TTL=60

# ===========================================
# ADMIN API
# ===========================================
ADMIN_API_KEY=test_admin_api_key_for_e2e

# ===========================================
# TEST CONFIGURATION
# ===========================================
# Port for E2E test server (different from dev)
PORT=4001

# Application settings
NODE_ENV=test
API_URL=http://localhost:4001

# CORS for testing
CORS_ORIGINS=http://localhost:4001
CORS_CREDENTIALS=true

# ===========================================
# LOGGING
# ===========================================
# Reduce log noise during tests
LOG_LEVEL=error
LOG_PRETTY=false

# ===========================================
# RATE LIMITING
# ===========================================
# Disable or increase rate limits for E2E tests
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# JOBS & BACKGROUND PROCESSING
# ===========================================
# Disable background jobs during E2E tests
# Jobs should be tested individually
JOBS_ENABLED=false
INDEXER_INTERVAL=999999
TX_STATUS_INTERVAL=999999
REMINDER_CRON=0 0 1 1 *

# ===========================================
# MOCK/TEST FLAGS
# ===========================================
# Set to 'true' to use mock Stellar SDK in tests
MOCK_STELLAR_SDK=false
# Set to 'true' to use mock Soroban RPC
MOCK_SOROBAN_RPC=false
